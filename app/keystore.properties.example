# Copy this file to "keystore.properties" (same folder) and fill in your own
# values. keystore.properties itself is gitignored -- never commit your real
# passwords or keystore file to version control.
#
# storeFile can be an absolute path or relative to the app/ module folder.
storeFile=../keys/escooter-control-release.jks
storePassword=CHANGE_ME
keyAlias=escooter-control
keyPassword=CHANGE_ME
